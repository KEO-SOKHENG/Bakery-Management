APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DATABASE_URL=null
DB_URL=null
DB_SOCKET=""
DB_CHARSET=utf8
DB_COLLATION=utf8mb4_unicode_ci
DB_SCHEMA=public
DB_SSLMODE=prefer
DB_FOREIGN_KEYS=true
MYSQL_ATTR_SSL_CA=null

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLUSTER=redis
REDIS_PREFIX=null
REDIS_PERSISTENT=false
REDIS_URL=null
REDIS_USERNAME=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Supabase / S3 Object Storage Configuration
SETTINGS_DISK=local
AWS_DRIVER=supabase-s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=bakery-media
AWS_ENDPOINT=https://rtrnlnezucgjkgqluofv.storage.supabase.co/storage/v1/s3
AWS_URL=https://rtrnlnezucgjkgqluofv.supabase.co/storage/v1/object/public/bakery-media
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Production Deployment & Initialization Flags
RUN_MIGRATIONS=false

# One-Time Production Administrator Bootstrap
# Enable once during initial setup on Render, then remove all BOOTSTRAP_ADMIN* variables
BOOTSTRAP_ADMIN=false
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# One-Time Production Administrator Password Reset
# Enable temporarily on Render to reset an existing administrator account's password, then immediately remove all RESET_ADMIN* variables
RESET_ADMIN_PASSWORD=false
RESET_ADMIN_USERNAME=""
RESET_ADMIN_EMAIL=""
RESET_ADMIN_NEW_PASSWORD=""
RESET_ADMIN_MUST_CHANGE_PASSWORD=true


# Login approval (OWNER_EMAIL skips approval; password is still required)
OWNER_EMAIL=
LOGIN_APPROVAL_ENABLED=true
LOGIN_APPROVAL_APPROVER_ROLES=admin,manager
LOGIN_APPROVAL_TTL=120
LOGIN_APPROVAL_ACTIVE_WINDOW=300
